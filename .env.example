# Configurazione OpenRouter (Consigliato per accedere a tutti i modelli con una sola chiave)
OPENROUTER_API_KEY=your_openrouter_api_key_here
LLM_MODEL=openrouter/openai/gpt-4o-mini
# Altri modelli supportati su OpenRouter:
# LLM_MODEL=openrouter/openai/gpt-4o
# LLM_MODEL=openrouter/anthropic/claude-3.5-sonnet
# LLM_MODEL=openrouter/meta-llama/llama-3.3-70b-instruct
# LLM_MODEL=openrouter/google/gemini-2.0-flash-001

# Se usi direttamente OpenAI:
# OPENAI_API_KEY=your_openai_api_key_here
# LLM_MODEL=gpt-4o

# Se usi Google Gemini direttamente:
# GEMINI_API_KEY=your_gemini_api_key_here
# LLM_MODEL=gemini/gemini-1.5-pro

# Se usi Ollama (in locale):
# LLM_MODEL=ollama/llama3.1
